PORT=3000
# PostgreSQL connection string
DATABASE_URL=postgres://mikhub:mikhub@localhost:5432/mikhub
# Set to true if your host requires SSL (Render, Neon, Supabase, Heroku, ...)
PGSSL=false
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Generate: node src/hash_password.js "your-password"
ADMIN_PASSWORD_HASH=
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Cloudflare R2 image storage (R2 dashboard -> Manage API tokens -> Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL: the r2.dev URL or your custom domain, e.g. https://pub-xxxx.r2.dev (no trailing slash)
R2_PUBLIC_URL=
